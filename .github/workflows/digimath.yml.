name: DigiMath daily posting

on:
  schedule:
    - cron: "0 6 * * *"    # 10:00 Baku (UTC+4) - questions
    - cron: "0 14 * * *"   # 18:00 Baku (UTC+4) - solutions
  workflow_dispatch:
    inputs:
      mode:
        description: "check / am / pm"
        required: true
        default: "check"

permissions:
  contents: write
  issues: write

concurrency:
  group: digimath
  cancel-in-progress: false

jobs:
  run:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Decide mode
        id: m
        run: |
          if [ "${{ github.event_name }}" = "workflow_dispatch" ]; then MODE="${{ inputs.mode }}"
          elif [ "${{ github.event.schedule }}" = "0 6 * * *" ]; then MODE=am
          elif [ "${{ github.event.schedule }}" = "0 14 * * *" ]; then MODE=pm
          else MODE=check; fi
          echo "mode=$MODE" >> "$GITHUB_OUTPUT"
          echo "Mode: $MODE"

      - name: Publish
        run: python3 publisher/publish.py "${{ steps.m.outputs.mode }}"
        env:
          IG_ACCESS_TOKEN: ${{ secrets.IG_ACCESS_TOKEN }}
          IG_USER_ID: ${{ secrets.IG_USER_ID }}
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

      - name: Save progress
        if: always()
        run: |
          git config user.name "digimath-bot"
          git config user.email "digimath-bot@users.noreply.github.com"
          git add state.json || true
          git diff --cached --quiet || (git commit -m "progress: ${{ steps.m.outputs.mode }}" && git pull --rebase && git push)
